[Unit]
Description=pibooth serial-to-uinput button bridge
After=multi-user.target

[Service]
Type=simple
User=pi
Group=pi
Environment=PYTHONUNBUFFERED=1
# Optional per-install overrides (PIBOOTH_SERIAL_PORT, _BUTTON1_KEY, …)
EnvironmentFile=-/etc/pibooth.env
ExecStart=/home/pi/.local/bin/pibooth-serial-buttons
Restart=on-failure
RestartSec=2

StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=default.target
